{:id          :isaac.cli-server
 :version     "0.2.1"
 :factory     isaac.module.protocol/module
 :description "Remote CLI server: a /cli WebSocket endpoint that runs hosted commands in-process and pipes command IO back. See PROTOCOL.md."

 :isaac.config/schema
 {:cli-server
  {:schema {:type :map
            :description "Remote CLI execution settings"
            :schema {:timeout-ms {:type :int
                                  :description "Wall-clock timeout for hosted commands; omit for no timeout"}}}}}

 ;; HTTP route contributed via the :isaac.http/route berth, exactly like /acp.
 ;; The handler authenticates at the upgrade, then runs the main CLI dispatch
 ;; with the client's handshake argv and frames the process IO.
 :isaac.http/route
 [{:method :get :path "/cli" :handler isaac.cli-server.ws/handler}]}
